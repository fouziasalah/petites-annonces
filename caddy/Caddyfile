# =============================================================================
# Reverse proxy HTTPS de la VM (option B) — utilisé par docker-compose.vm.yml.
#
# Caddy obtient et renouvelle AUTOMATIQUEMENT les certificats Let's Encrypt pour
# chaque nom ci-dessous (challenge HTTP sur le port 80). PUBLIC_DOMAIN vaut par
# exemple 72-60-188-97.sslip.io : sslip.io est un DNS public qui fait pointer
# app.72-60-188-97.sslip.io vers 72.60.188.97, sans acheter de domaine.
#
# Pourquoi HTTPS est indispensable :
#   - Keycloak (sslRequired: external) refuse le HTTP depuis une IP publique ;
#   - les tokens et mots de passe ne doivent pas circuler en clair sur Internet.
#
# Caddy transmet X-Forwarded-For / -Proto / -Host : Keycloak s'en sert
# (KC_PROXY_HEADERS=xforwarded) pour savoir que le client est en HTTPS.
# =============================================================================

app.{$PUBLIC_DOMAIN} {
	encode gzip
	reverse_proxy frontend:8080
}

api.{$PUBLIC_DOMAIN} {
	reverse_proxy gateway:8000
}

auth.{$PUBLIC_DOMAIN} {
	reverse_proxy keycloak:8080
}
