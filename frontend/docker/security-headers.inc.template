# En-têtes de sécurité, inclus dans CHAQUE location : en Nginx, un add_header dans une
# location annule tous ceux hérités du bloc server (piège classique).
#
# Content-Security-Policy : défense contre le XSS. Les tokens étant en sessionStorage,
# un script injecté pourrait les lire ; la CSP n'autorise que les scripts de notre
# origine, et les appels réseau vers Keycloak et la gateway uniquement.
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ${KC_PUBLIC_URL} ${GATEWAY_PUBLIC_URL}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
# Pas de Referer : l'URL de retour de Keycloak (?code=…&state=…) ne doit pas fuiter.
add_header Referrer-Policy "no-referrer" always;
