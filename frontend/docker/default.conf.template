# Configuration Nginx du front (les ${VARIABLES} sont remplacées au démarrage par
# l'image officielle, à partir des variables d'environnement définies).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # Configuration runtime, générée au démarrage : jamais en cache.
    location = /config.json {
        alias /tmp/app-config/config.json;
        default_type application/json;
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-store" always;
    }

    # Fichiers avec empreinte dans le nom (main-XXXX.js) : cache long et immuable.
    location ~* \.(?:js|css|woff2?|ico|png|svg)$ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Application monopage : toute route inconnue (/annonces/42, /moderation…) sert
    # index.html, et c'est le routeur Angular qui affiche le bon écran.
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
