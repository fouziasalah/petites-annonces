{
  "realm": "annonces",
  "displayName": "PetitesAnnonces",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "internationalizationEnabled": true,
  "supportedLocales": ["fr", "en"],
  "defaultLocale": "fr",
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Consulter les annonces publiées, gérer ses propres annonces"
      },
      {
        "name": "MODERATEUR",
        "description": "USER + publier, rejeter et supprimer n'importe quelle annonce",
        "composite": true,
        "composites": { "realm": ["USER"] }
      },
      {
        "name": "ADMIN",
        "description": "MODERATEUR + gérer les catégories",
        "composite": true,
        "composites": { "realm": ["MODERATEUR"] }
      }
    ]
  },
  "clients": [
    {
      "clientId": "annonces-front",
      "name": "PetitesAnnonces (SPA Angular)",
      "description": "Client public : Authorization Code + PKCE S256 uniquement",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": true,
      "rootUrl": "${FRONT_PUBLIC_URL}",
      "baseUrl": "/",
      "redirectUris": ["${FRONT_PUBLIC_URL}/*"],
      "webOrigins": ["${FRONT_PUBLIC_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${FRONT_PUBLIC_URL}/*",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      }
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@petitesannonces.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Martin",
      "realmRoles": ["USER"],
      "credentials": [{ "type": "password", "value": "${REALM_PWD_ALICE}", "temporary": false }]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@petitesannonces.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Durand",
      "realmRoles": ["USER"],
      "credentials": [{ "type": "password", "value": "${REALM_PWD_BOB}", "temporary": false }]
    },
    {
      "username": "modo",
      "enabled": true,
      "email": "modo@petitesannonces.test",
      "emailVerified": true,
      "firstName": "Mona",
      "lastName": "Dérateur",
      "realmRoles": ["MODERATEUR"],
      "credentials": [{ "type": "password", "value": "${REALM_PWD_MODO}", "temporary": false }]
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@petitesannonces.test",
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Ministre",
      "realmRoles": ["ADMIN"],
      "credentials": [{ "type": "password", "value": "${REALM_PWD_ADMIN}", "temporary": false }]
    }
  ],
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "rsa-annonces-fixe",
        "providerId": "rsa",
        "subComponents": {},
        "config": {
          "priority": ["200"],
          "enabled": ["true"],
          "active": ["true"],
          "algorithm": ["RS256"],
          "keyUse": ["SIG"],
          "privateKey": ["${REALM_RSA_PRIVATE_KEY}"],
          "certificate": ["${REALM_RSA_CERTIFICATE}"]
        }
      },
      {
        "name": "hmac-generated",
        "providerId": "hmac-generated",
        "subComponents": {},
        "config": { "priority": ["100"], "algorithm": ["HS512"] }
      },
      {
        "name": "aes-generated",
        "providerId": "aes-generated",
        "subComponents": {},
        "config": { "priority": ["100"] }
      }
    ]
  }
}
