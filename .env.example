# =============================================================================
# Variables d'environnement de PetitesAnnonces — VALEURS DE DÉVELOPPEMENT
#
#   cp .env.example .env      puis    docker compose up -d --build --wait
#
# Docker Compose lit automatiquement le fichier .env (jamais commité).
# Ces valeurs sont publiques : à remplacer pour tout environnement exposé
# (scripts/gen-keys.sh génère une nouvelle paire de clés).
# =============================================================================

# --- Mots de passe des utilisateurs de test du realm « annonces » ---
REALM_PWD_ALICE=alice-dev
REALM_PWD_BOB=bob-dev
REALM_PWD_MODO=modo-dev
REALM_PWD_ADMIN=admin-dev

# --- Paire de clés RSA qui signe les tokens (CLÉ DE DÉVELOPPEMENT UNIQUEMENT) ---
# Générée par scripts/gen-keys.sh ; la clé publique correspondante est dans kong/kong.yml.
REALM_RSA_PRIVATE_
REALM_RSA_
