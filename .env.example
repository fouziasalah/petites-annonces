# =============================================================================
# Variables d'environnement de PetitesAnnonces — VALEURS DE DÉVELOPPEMENT
#
#   cp .env.example .env        (le .env réel est ignoré par Git)
#
# Ces valeurs permettent un démarrage local immédiat (DEP-01). Elles sont
# publiques, donc NE JAMAIS les utiliser sur un environnement exposé :
# en production, générer de nouvelles valeurs (scripts/gen-keys.sh .env.prod)
# et les stocker dans le secret GitHub ENV_FILE.
# =============================================================================

# --- Images (CI/CD) ----------------------------------------------------------
DOCKERHUB_USERNAME=local
IMAGE_TAG=latest

# Interface sur laquelle les ports sont publiés. 127.0.0.1 = accessibles
# uniquement depuis la machine elle-même (ou via un tunnel SSH sur la VM).
# Docker contourne le pare-feu ufw : publier sur 0.0.0.0 expose réellement les ports.
BIND_ADDRESS=127.0.0.1

# --- URLs publiques, telles que vues par le NAVIGATEUR ----------------------
# KC_PUBLIC_URL détermine le claim « iss » des tokens : il doit correspondre
# au caractère près à la « key » du credential Kong (pas de slash final).
FRONT_PUBLIC_URL=http://localhost:4200
GATEWAY_PUBLIC_URL=http://localhost:8080
KC_PUBLIC_URL=http://localhost:8180

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_PASSWORD=dev-postgres-superuser
KEYCLOAK_DB_PASSWORD=dev-keycloak-db
ANNONCES_DB_PASSWORD=dev-annonces-db

# --- Keycloak : compte d'administration (realm master) -----------------------
KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=dev-kcadmin

# --- Realm « annonces » : injectés dans keycloak/realm-annonces.json ---------
# Mots de passe des utilisateurs de test
REALM_PWD_ALICE=alice-dev
REALM_PWD_BOB=bob-dev
REALM_PWD_MODO=modo-dev
REALM_PWD_ADMIN=admin-dev

# Paire RSA de signature des tokens — CLÉ DE DÉVELOPPEMENT UNIQUEMENT.
# Générée par scripts/gen-keys.sh ; sa clé publique est dans kong/kong.yml.
REALM_RSA_PRIVATE_
REALM_RSA_
